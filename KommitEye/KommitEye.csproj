<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>3.3.1</Version>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
    <EmbeddedResource Include="models.example.conf" LogicalName="KommitEye.Templates.models.example.conf" />
    <EmbeddedResource Include="system-prompt.example.txt" LogicalName="KommitEye.Templates.system-prompt.example.txt" />
    <EmbeddedResource Include="system-prompt.ru.example.txt" LogicalName="KommitEye.Templates.system-prompt.ru.example.txt" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Google.Apis.Auth" Version="1.73.0" />
    <PackageReference Include="MailKit" Version="4.18.1" />
    <PackageReference Include="Microsoft.Identity.Client" Version="4.90.1" />
  </ItemGroup>

</Project>
