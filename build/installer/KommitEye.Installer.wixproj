<Project Sdk="WixToolset.Sdk/6.0.2">
  <PropertyGroup>
    <OutputType>Package</OutputType>
    <InstallerPlatform>x64</InstallerPlatform>
    <OutputName>KommitEye-WebServer-$(WebServerVersion)-win-x64</OutputName>
    <DefineConstants>$(DefineConstants);ServerVersion=$(WebServerVersion);PayloadDir=$(PayloadDir)</DefineConstants>
    <Cultures>en-US</Cultures>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="WixToolset.UI.wixext" Version="6.0.2" />
    <PackageReference Include="WixToolset.Util.wixext" Version="6.0.2" />
    <PackageReference Include="WixToolset.Firewall.wixext" Version="6.0.2" />
    <PackageReference Include="WixToolset.Netfx.wixext" Version="6.0.2" />
    <ProjectReference Include="CustomActions/CustomActions.csproj" />
  </ItemGroup>
  <Target Name="RequirePayload" BeforeTargets="BeforeBuild">
    <Error Condition="!Exists('$(PayloadDir)/KommitEye.Server.exe')" Text="Build with build/publish.ps1 or supply PayloadDir containing the published server and wwwroot." />
  </Target>
</Project>
