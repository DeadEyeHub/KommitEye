<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:firewall="http://wixtoolset.org/schemas/v4/wxs/firewall">
  <Package Name="KommitEye Service" Manufacturer="KommitEye" Version="$(ServerVersion)"
           UpgradeCode="E890EB6F-890F-48B4-A234-5F6278711F5A" Scope="perMachine" InstallerVersion="500" Language="1033">
    <MajorUpgrade DowngradeErrorMessage="A newer KommitEye Service is already installed." Schedule="afterInstallExecute" />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />
    <Icon Id="AppIcon" SourceFile="../../KommitEye/Assets/app.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />
    <Property Id="ARPNOMODIFY" Value="1" />
    <!-- Keep Restart Manager file-use detection. Fully disabling it falls back
         to the legacy process scan, which can stall InstallValidate for minutes.
         Executable commands own the service lifecycle. -->
    <Property Id="MSIRESTARTMANAGERCONTROL" Value="DisableShutdown" />
    <Property Id="MsiLogging" Value="voicewarmup" />
    <PropertyRef Id="WIX_IS_NETFRAMEWORK_472_OR_LATER_INSTALLED" />
    <Launch Condition="Installed OR (VersionNT64 AND WIX_IS_NETFRAMEWORK_472_OR_LATER_INSTALLED)" Message="This installer requires 64-bit Windows and .NET Framework 4.7.2 or newer (included in supported Windows 10/11 installations). The server's .NET 10 runtime is included." />
    <Property Id="INSTALLFOLDER" Secure="yes" />
    <Property Id="DATADIR" Secure="yes" />
    <Property Id="DATAPATH" Secure="yes" />
    <Property Id="CONFIGDIR" Secure="yes" />
    <Property Id="CONFIGFILE" Secure="yes" />
    <Property Id="PORT" Secure="yes" />
    <Property Id="ACCESSMODE" Secure="yes" />
    <Property Id="NETWORKCHOICE" Value="lan" />
    <Property Id="FIREWALL" Secure="yes" />
    <Property Id="AUTOSTART" Secure="yes" />
    <Property Id="STARTNOW" Secure="yes" />
    <Property Id="STARTCHOICE" Value="1" />
    <Property Id="AUTOCHOICE" Value="1" />
    <Property Id="FIREWALLCHOICE" Value="1" />
    <Property Id="SERVICEACCOUNT" Secure="yes" />
    <Property Id="GITEXE" Secure="yes" />
    <Property Id="LISTENHOST" Secure="yes" />
    <Property Id="BINDIP" Secure="yes" />
    <Property Id="LANADDRESS" Value="LAN access is disabled." />
    <Property Id="SETUP_INITIALIZED" Secure="yes" />
    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Open the web interface to create the administrator password" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />

    <StandardDirectory Id="ProgramFiles64Folder"><Directory Id="INSTALLFOLDER" Name="KommitEye Server" /></StandardDirectory>
    <StandardDirectory Id="CommonAppDataFolder"><Directory Id="ProductDataRoot" Name="KommitEye"><Directory Id="CONFIGDIR" Name="Server"><Directory Id="DATADIR" Name="data" /></Directory></Directory></StandardDirectory>
    <DirectoryRef Id="INSTALLFOLDER">
      <Component Id="NativeSqlite" Guid="ECC234A7-609C-43E2-9FA7-0BEFCE236EE4" Bitness="always64">
        <!-- SQLite's version resource omits language; explicitly author it as neutral. -->
        <File Id="NativeSqliteDll" Source="$(PayloadDir)\e_sqlite3.dll" DefaultLanguage="0" KeyPath="yes" />
      </Component>
      <Component Id="ServerService" Guid="D1D05A03-D1F1-43AC-8FF1-E77B225D547F" Bitness="always64">
        <File Id="ServerExe" Source="$(PayloadDir)\KommitEye.Server.exe" KeyPath="yes" />
      </Component>
      <Component Id="SavedSettings" Guid="FA49F4C2-CAAA-44C6-BD06-9AFFC395D72A" Bitness="always64" Permanent="yes">
        <RegistryKey Root="HKLM" Key="SOFTWARE\KommitEye\Server">
          <RegistryValue Name="INSTALLFOLDER" Value="[INSTALLFOLDER]" Type="string" KeyPath="yes" />
          <RegistryValue Name="DATADIR" Value="[DATAPATH]" Type="string" />
          <RegistryValue Name="CONFIGDIR" Value="[CONFIGDIR]" Type="string" />
          <RegistryValue Name="PORT" Value="[PORT]" Type="string" />
          <RegistryValue Name="BINDIP" Value="[BINDIP]" Type="string" />
          <RegistryValue Name="ACCESSMODE" Value="[ACCESSMODE]" Type="string" />
          <RegistryValue Name="FIREWALL" Value="[FIREWALL]" Type="string" />
          <RegistryValue Name="AUTOSTART" Value="[AUTOSTART]" Type="string" />
          <RegistryValue Name="SERVICEACCOUNT" Value="[SERVICEACCOUNT]" Type="string" />
          <RegistryValue Name="GITEXE" Value="[GITEXE]" Type="string" />
        </RegistryKey>
      </Component>
      <Component Id="LanFirewall" Guid="BA50F5C6-32CE-41F4-ACCC-A8639C9B1319" Condition="FIREWALL = &quot;1&quot; AND (ACCESSMODE = &quot;lan&quot; OR ACCESSMODE = &quot;ip&quot;)" Bitness="always64">
        <RegistryValue Root="HKLM" Key="SOFTWARE\KommitEye\Server" Name="FirewallInstalled" Value="1" Type="integer" KeyPath="yes" />
        <firewall:FirewallException Id="PrivateLan" Name="KommitEye Service (private LAN)" Program="[#ServerExe]" Port="[PORT]" Protocol="tcp" Profile="private" Scope="localSubnet" />
        <firewall:FirewallException Id="DomainLan" Name="KommitEye Service (domain LAN)" Program="[#ServerExe]" Port="[PORT]" Protocol="tcp" Profile="domain" Scope="localSubnet" />
      </Component>
    </DirectoryRef>
    <DirectoryRef Id="DATADIR">
      <Component Id="PersistentDataFolder" Guid="F5D4109C-D109-4E6C-A297-3D15E681AC56" Permanent="yes" Bitness="always64">
        <RegistryValue Root="HKLM" Key="SOFTWARE\KommitEye\Server" Name="DataFolderManagedByExe" Value="1" Type="integer" KeyPath="yes" />
      </Component>
    </DirectoryRef>
    <DirectoryRef Id="DATADIR">
    </DirectoryRef>
    <DirectoryRef Id="CONFIGDIR">
      <Component Id="PersistentConfigurationFolder" Guid="F45E0FB4-543B-4FB9-A925-568BFE9C3F93" Bitness="always64" Permanent="yes">
        <RegistryValue Root="HKLM" Key="SOFTWARE\KommitEye\Server" Name="ConfigFolderManagedByExe" Value="1" Type="integer" KeyPath="yes" />
      </Component>
    </DirectoryRef>
    <DirectoryRef Id="INSTALLFOLDER">
    </DirectoryRef>
    <Feature Id="Server" Title="KommitEye Service" Level="1">
      <ComponentRef Id="ServerService" /><ComponentRef Id="SavedSettings" />
      <ComponentRef Id="LanFirewall" /><ComponentRef Id="PersistentDataFolder" />

      <ComponentRef Id="NativeSqlite" />
      <ComponentRef Id="PersistentConfigurationFolder" />
      <Files Include="$(PayloadDir)\**" Directory="INSTALLFOLDER">
        <Exclude Files="$(PayloadDir)\KommitEye.Server.exe" />
        <Exclude Files="$(PayloadDir)\e_sqlite3.dll" />
        <Exclude Files="$(PayloadDir)\*.ps1" />
        <Exclude Files="$(PayloadDir)\README.txt" />
      </Files>
    </Feature>

    <Binary Id="SetupActions" SourceFile="$(var.CustomActions.TargetDir)KommitEye.SetupActions.CA.dll" />
    <CustomAction Id="InitializeSettings" BinaryRef="SetupActions" DllEntry="InitializeSettings" Execute="immediate" Return="check" />
    <CustomAction Id="ValidateNetwork" BinaryRef="SetupActions" DllEntry="ValidateNetwork" Execute="immediate" Return="check" />
    <CustomAction Id="ValidateDialog" BinaryRef="SetupActions" DllEntry="ValidateDialog" Execute="immediate" Return="check" HideTarget="yes" />
    <CustomAction Id="ValidateExecute" BinaryRef="SetupActions" DllEntry="ValidateExecute" Execute="immediate" Return="check" HideTarget="yes" />
    <CustomAction Id="PrepareServiceTransaction" BinaryRef="SetupActions" DllEntry="PrepareServiceTransaction" Execute="immediate" Return="check" HideTarget="yes" />
    <Property Id="BeginServiceTransaction" Hidden="yes" />
    <CustomAction Id="BeginServiceTransaction" BinaryRef="SetupActions" DllEntry="BeginServiceTransaction" Execute="deferred" Impersonate="no" Return="check" HideTarget="yes" />
    <Property Id="RollbackServiceTransaction" Hidden="yes" />
    <CustomAction Id="RollbackServiceTransaction" BinaryRef="SetupActions" DllEntry="RollbackServiceTransaction" Execute="rollback" Impersonate="no" Return="check" HideTarget="yes" />
    <Property Id="RollbackNewService" Hidden="yes" />
    <CustomAction Id="RollbackNewService" BinaryRef="SetupActions" DllEntry="RollbackNewService" Execute="rollback" Impersonate="no" Return="check" HideTarget="yes" />
    <Property Id="RegisterServer" Hidden="yes" />
    <CustomAction Id="RegisterServer" BinaryRef="SetupActions" DllEntry="RegisterServer" Execute="deferred" Impersonate="no" Return="check" HideTarget="yes" />
    <Property Id="CommitServiceTransaction" Hidden="yes" />
    <CustomAction Id="CommitServiceTransaction" BinaryRef="SetupActions" DllEntry="CommitServiceTransaction" Execute="commit" Impersonate="no" Return="check" HideTarget="yes" />
    <CustomAction Id="WriteServiceConfig" BinaryRef="SetupActions" DllEntry="WriteServiceConfig" Execute="deferred" Impersonate="no" Return="check" />
    <CustomAction Id="OpenBrowser" BinaryRef="SetupActions" DllEntry="OpenBrowser" Execute="immediate" Return="ignore" />
    <InstallUISequence><Custom Action="InitializeSettings" After="AppSearch" Condition="NOT (REMOVE = &quot;ALL&quot;)" /></InstallUISequence>
    <InstallExecuteSequence>
      <Custom Action="InitializeSettings" After="AppSearch" Condition="NOT (REMOVE = &quot;ALL&quot;)" />
      <Custom Action="ValidateExecute" Before="InstallInitialize" Condition="NOT (REMOVE = &quot;ALL&quot;)" />
      <Custom Action="PrepareServiceTransaction" Before="InstallInitialize" Condition="NOT UPGRADINGPRODUCTCODE" />
      <Custom Action="RollbackServiceTransaction" Before="BeginServiceTransaction" Condition="NOT UPGRADINGPRODUCTCODE" />
      <Custom Action="BeginServiceTransaction" After="InstallInitialize" Condition="NOT UPGRADINGPRODUCTCODE" />
      <Custom Action="WriteServiceConfig" After="InstallFiles" Condition="NOT (REMOVE = &quot;ALL&quot;)" />
      <Custom Action="RollbackNewService" After="RemoveExistingProducts" Condition="NOT (REMOVE = &quot;ALL&quot;)" />
      <Custom Action="RegisterServer" After="RollbackNewService" Condition="NOT (REMOVE = &quot;ALL&quot;)" />
      <Custom Action="CommitServiceTransaction" After="RegisterServer" Condition="NOT UPGRADINGPRODUCTCODE" />
      <InstallExecuteAgain After="CommitServiceTransaction" />
    </InstallExecuteSequence>
    <UIRef Id="KommitEyeUI" />
  </Package>
</Wix>
