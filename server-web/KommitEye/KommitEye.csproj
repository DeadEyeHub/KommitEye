<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
    <EmbeddedResource Include="models.example.conf" LogicalName="KommitEye.Templates.models.example.conf" />
    <EmbeddedResource Include="system-prompt.example.txt" LogicalName="KommitEye.Templates.system-prompt.example.txt" />
    <EmbeddedResource Include="system-prompt.ru.example.txt" LogicalName="KommitEye.Templates.system-prompt.ru.example.txt" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../src/KommitEye.Engine/KommitEye.Engine.csproj" />
  </ItemGroup>

</Project>
